#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
command=${1:-help}
if [[ "$command" == update ]]; then
  [[ -z $(git status --porcelain --untracked-files=normal) ]] || { echo 'Tracked source or untracked files changed; commit/move them before update.' >&2; exit 1; }
  git pull --ff-only origin main
  shift
  exec bash scripts/install-workstation.sh "$@"
fi
case "$command" in
  install|migrate) shift; exec bash scripts/install-workstation.sh "$@";;
  infra-update) exec bash scripts/install-infra.sh;;
  *) shift || true; exec python3 scripts/manage.py "$command" "$@";;
esac
